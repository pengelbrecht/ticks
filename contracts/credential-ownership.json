{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ticks.sh/contracts/credential-ownership.json",
  "schema_version": 1,
  "contract": "ticfac.credentials",
  "file": {
    "path": "~/.ticfacrc",
    "mode": "0600",
    "format": "line-oriented key=value",
    "encoding": "UTF-8",
    "unknown_lines": "preserved",
    "atomic_writes": "temp+rename"
  },
  "ownership": [
    {
      "credential_type": "deployment",
      "owner": "ticfac",
      "file_keys": ["factory_url", "factory_token", "factory_version"]
    },
    {
      "credential_type": "model_access",
      "owner": "ticfac",
      "file_keys": ["factory_gateway_provider", "factory_gateway_key"]
    },
    {
      "credential_type": "gateway",
      "owner": "ticfac",
      "file_keys": [
        "factory_gateway_url",
        "factory_cloudflare_api_token",
        "factory_workers_ai_billing_mode"
      ]
    },
    {
      "credential_type": "subscription_broker",
      "owner": "ticfac",
      "file_keys": []
    },
    {
      "credential_type": "github_app_installation",
      "owner": "ticfac",
      "file_keys": [
        "factory_github_token",
        "factory_github_login",
        "factory_github_repo",
        "factory_github_auth",
        "factory_github_token_expires_at",
        "factory_github_refresh_token",
        "factory_github_refresh_token_expires_at"
      ]
    },
    {
      "credential_type": "run_token",
      "owner": "ticfac",
      "file_keys": []
    }
  ],
  "ticks": {
    "execution_credentials": [],
    "board_sync_file": "~/.ticksrc",
    "git": "Ticks does not issue or persist execution credentials. Ordinary Git/SSH authentication for a human checkout remains Git's own credential helper or agent; ticfac owns source access for jobs."
  },
  "keys": [
    {
      "name": "factory_url",
      "credential_type": "deployment",
      "secret": false,
      "stored_in": ["~/.ticfacrc"]
    },
    {
      "name": "factory_token",
      "credential_type": "deployment",
      "secret": true,
      "stored_in": ["~/.ticfacrc", "worker hash only"]
    },
    {
      "name": "factory_version",
      "credential_type": "deployment",
      "secret": false,
      "stored_in": ["~/.ticfacrc"]
    },
    {
      "name": "factory_github_token",
      "credential_type": "github_app_installation",
      "secret": true,
      "stored_in": ["~/.ticfacrc", "worker secret GITHUB_TOKEN"]
    },
    {
      "name": "factory_github_login",
      "credential_type": "github_app_installation",
      "secret": false,
      "stored_in": ["~/.ticfacrc"]
    },
    {
      "name": "factory_github_repo",
      "credential_type": "github_app_installation",
      "secret": false,
      "stored_in": ["~/.ticfacrc"]
    },
    {
      "name": "factory_github_auth",
      "credential_type": "github_app_installation",
      "secret": false,
      "stored_in": ["~/.ticfacrc"]
    },
    {
      "name": "factory_github_token_expires_at",
      "credential_type": "github_app_installation",
      "secret": false,
      "stored_in": ["~/.ticfacrc"]
    },
    {
      "name": "factory_github_refresh_token",
      "credential_type": "github_app_installation",
      "secret": true,
      "stored_in": ["~/.ticfacrc"]
    },
    {
      "name": "factory_github_refresh_token_expires_at",
      "credential_type": "github_app_installation",
      "secret": false,
      "stored_in": ["~/.ticfacrc"]
    },
    {
      "name": "factory_gateway_url",
      "credential_type": "gateway",
      "secret": false,
      "stored_in": ["~/.ticfacrc", "worker environment"]
    },
    {
      "name": "factory_gateway_provider",
      "credential_type": "model_access",
      "secret": false,
      "stored_in": ["~/.ticfacrc", "worker environment"]
    },
    {
      "name": "factory_gateway_key",
      "credential_type": "model_access",
      "secret": true,
      "stored_in": ["~/.ticfacrc", "worker provider secret"]
    },
    {
      "name": "factory_cloudflare_api_token",
      "credential_type": "gateway",
      "secret": true,
      "stored_in": ["~/.ticfacrc", "worker secret CLOUDFLARE_API_TOKEN"]
    },
    {
      "name": "factory_workers_ai_billing_mode",
      "credential_type": "gateway",
      "secret": false,
      "stored_in": ["~/.ticfacrc"]
    }
  ],
  "schema": {
    "type": "object",
    "required": [],
    "additionalProperties": false,
    "properties": {
      "factory_url": {
        "type": "string",
        "format": "uri",
        "minLength": 1
      },
      "factory_token": {
        "type": "string",
        "minLength": 1
      },
      "factory_version": {
        "type": "string",
        "minLength": 1
      },
      "factory_github_token": {
        "type": "string",
        "minLength": 1
      },
      "factory_github_login": {
        "type": "string",
        "minLength": 1
      },
      "factory_github_repo": {
        "type": "string",
        "pattern": "^[^/\\s]+/[^/\\s]+$"
      },
      "factory_github_auth": {
        "type": "string",
        "enum": ["device-flow", "pat"]
      },
      "factory_github_token_expires_at": {
        "oneOf": [
          { "const": "" },
          { "type": "string", "format": "date-time" }
        ]
      },
      "factory_github_refresh_token": {
        "type": "string",
        "minLength": 1
      },
      "factory_github_refresh_token_expires_at": {
        "oneOf": [
          { "const": "" },
          { "type": "string", "format": "date-time" }
        ]
      },
      "factory_gateway_url": {
        "type": "string",
        "format": "uri",
        "minLength": 1
      },
      "factory_gateway_provider": {
        "type": "string",
        "enum": ["workers-ai", "anthropic", "openai", "openrouter"]
      },
      "factory_gateway_key": {
        "type": "string"
      },
      "factory_cloudflare_api_token": {
        "type": "string",
        "minLength": 1
      },
      "factory_workers_ai_billing_mode": {
        "type": "string",
        "enum": ["postpaid", "unified"]
      }
    }
  },
  "valid_example": {
    "factory_url": "https://factory.example.invalid",
    "factory_token": "<redacted-factory-token>",
    "factory_version": "0.31.0",
    "factory_github_token": "<redacted-github-token>",
    "factory_github_login": "example-bot",
    "factory_github_repo": "example-org/example-repo",
    "factory_github_auth": "device-flow",
    "factory_github_token_expires_at": "",
    "factory_github_refresh_token": "<redacted-github-refresh-token>",
    "factory_github_refresh_token_expires_at": "2026-12-31T00:00:00Z",
    "factory_gateway_url": "https://gateway.example.invalid/v1/example-account/example-gateway",
    "factory_gateway_provider": "anthropic",
    "factory_gateway_key": "<redacted-provider-key>",
    "factory_cloudflare_api_token": "<redacted-cloudflare-token>",
    "factory_workers_ai_billing_mode": "postpaid"
  },
  "lifecycle": {
    "stop": {
      "revoke_before_stop": true,
      "refuse_issue_before_every_boot": true,
      "cancelled_handle_cannot_reissue": true,
      "rule": "A stop is a durable refusal to issue credentials, not a revocation a restart can undo."
    },
    "cost": {
      "metered": {
        "budget_field": "max_cost_usd",
        "telemetry": "gateway",
        "unknown_cost": "refuse when a cost budget is configured"
      },
      "flat_rate_seat": {
        "no_cost_budget": true,
        "wall_clock_still_applies": true,
        "quota_failure": "quota_exhausted"
      }
    },
    "security": {
      "never_print_tokens": true,
      "read_only_grade": {
        "operator_github_token_never_issued": true,
        "credential": "run_token",
        "git_write": "refused",
        "default_grade": "write"
      }
    }
  },
  "migration": {
    "source": "~/.ticksrc",
    "destination": "~/.ticfacrc",
    "match": "factory_*",
    "steps": [
      "Load ~/.ticfacrc and scan ~/.ticksrc for assignment lines whose key starts with factory_.",
      "Copy only values absent from ~/.ticfacrc, preserving the destination value if it already exists.",
      "Atomically save ~/.ticfacrc at 0600 before atomically rewriting ~/.ticksrc without factory_ lines; preserve all other lines.",
      "Emit one stderr notice only when values were copied; no notice on a no-op or a resumed drain."
    ],
    "crash_safety": "If the process dies after destination save and before source drain, the next invocation sees destination values and only drains the old lines; it never overwrites a newer destination value.",
    "retention": "Read the legacy shape indefinitely by default; remove that compatibility path only in a later explicit decision."
  }
}

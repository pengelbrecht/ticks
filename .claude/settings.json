{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-skill-edits.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/Users/peterengelbrecht/Development/canonify/.agents/skills/repo-wiki/scripts/kb.py\" session-start 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
